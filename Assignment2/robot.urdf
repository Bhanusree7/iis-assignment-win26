<robot name="domestic_assistant">
  <link name="world" />
  <link name="base_x_link" />
  <link name="base_y_link" />
  <joint name="base_x" type="prismatic">
    <parent link="world" />
    <child link="base_x_link" />
    <axis xyz="1 0 0" />
    <limit lower="-3" upper="3" effort="500" velocity="1.0" />
  </joint>
  <joint name="base_y" type="prismatic">
    <parent link="base_x_link" />
    <child link="base_y_link" />
    <axis xyz="0 1 0" />
    <limit lower="-3" upper="3" effort="500" velocity="1.0" />
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" />
      <geometry>
        <cylinder radius="0.25" length="0.3" />
      </geometry>
      <material name="base_grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" />
      <geometry>
        <cylinder radius="0.25" length="0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" />
      <mass value="20" />
      <inertia ixx="0.4625" ixy="0" ixz="0" iyy="0.4625" iyz="0" izz="0.625" />
    </inertial>
  </link>
  <joint name="base_yaw" type="continuous">
    <parent link="base_y_link" />
    <child link="base_link" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="lift_link">
    <visual>
      <origin xyz="0 0 0.05" />
      <geometry>
        <box size="0.08 0.08 0.1" />
      </geometry>
      <material name="lift_mat">
        <color rgba="0.7 0.7 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" />
      <geometry>
        <box size="0.08 0.08 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" />
      <mass value="3.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005" />
    </inertial>
  </link>
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link" />
    <child link="lift_link" />
    <origin xyz="0 0 0.3" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.4" effort="300" velocity="0.2" />
    <dynamics damping="1.0" friction="0.5" />
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0.175 0 0" />
      <geometry>
        <box size="0.35 0.06 0.06" />
      </geometry>
      <material name="link1_mat">
        <color rgba="0.1 0.4 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" />
      <geometry>
        <box size="0.35 0.06 0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0157625" iyz="0" izz="0.0157625" />
    </inertial>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="lift_link" />
    <child link="link1" />
    <origin xyz="0 0 0.1" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.5707963268" upper="1.5707963268" effort="80" velocity="1.5" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0.15 0 0" />
      <geometry>
        <box size="0.3 0.06 0.06" />
      </geometry>
      <material name="link2_mat">
        <color rgba="0.1 0.6 0.9 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" />
      <geometry>
        <box size="0.3 0.06 0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0117" iyz="0" izz="0.0117" />
    </inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0.35 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.5" upper="2.5" effort="50" velocity="2.0" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link name="wrist_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5707963268 0" />
      <geometry>
        <cylinder radius="0.03" length="0.04" />
      </geometry>
      <material name="wrist_mat">
        <color rgba="0.8 0.4 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5707963268 0" />
      <geometry>
        <cylinder radius="0.03" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0" />
      <mass value="0.3" />
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4" />
    </inertial>
  </link>
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="link2" />
    <child link="wrist_link" />
    <origin xyz="0.3 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1415926536" upper="3.1415926536" effort="10" velocity="3.0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>
  <link name="palm">
    <visual>
      <origin xyz="0.015 0 0" />
      <geometry>
        <box size="0.03 0.164 0.04" />
      </geometry>
      <material name="palm_mat">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.015 0 0" />
      <geometry>
        <box size="0.03 0.164 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.015 0 0" />
      <mass value="0.3" />
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4" />
    </inertial>
  </link>
  <joint name="palm_joint" type="fixed">
    <parent link="wrist_link" />
    <child link="palm" />
    <origin xyz="0.04 0 0" />
  </joint>
  <link name="finger_left">
    <visual>
      <origin xyz="0.05 0 0" />
      <geometry>
        <box size="0.1 0.012 0.04" />
      </geometry>
      <material name="finger_left_mat">
        <color rgba="0.9 0.8 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" />
      <geometry>
        <box size="0.1 0.012 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0" />
      <mass value="0.05" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="palm" />
    <child link="finger_left" />
    <origin xyz="0.03 0.016 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.06" effort="20" velocity="0.1" />
    <dynamics damping="0.5" friction="0.2" />
  </joint>
  <link name="finger_right">
    <visual>
      <origin xyz="0.05 0 0" />
      <geometry>
        <box size="0.1 0.012 0.04" />
      </geometry>
      <material name="finger_right_mat">
        <color rgba="0.9 0.8 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" />
      <geometry>
        <box size="0.1 0.012 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0" />
      <mass value="0.05" />
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
    </inertial>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="palm" />
    <child link="finger_right" />
    <origin xyz="0.03 -0.016 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.06" effort="20" velocity="0.1" />
    <dynamics damping="0.5" friction="0.2" />
  </joint>
  <link name="tool_frame" />
  <joint name="tool_joint" type="fixed">
    <parent link="palm" />
    <child link="tool_frame" />
    <origin xyz="0.08 0 0" />
  </joint>
  <link name="fridge_door_shelf">
    <visual>
      <geometry>
        <box size="0.3 0.6 0.02" />
      </geometry>
      <material name="fridge_door_shelf_mat">
        <color rgba="0.9 0.9 0.95 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.6 0.02" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="fridge_door_shelf_joint" type="fixed">
    <parent link="world" />
    <child link="fridge_door_shelf" />
    <origin xyz="0.65 0 0.39" />
  </joint>
  <link name="milk_carton">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.2" />
      </geometry>
      <material name="milk_carton_mat">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.2" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="milk_carton_joint" type="fixed">
    <parent link="world" />
    <child link="milk_carton" />
    <origin xyz="0.55 0 0.5" />
  </joint>
  <link name="counter">
    <visual>
      <geometry>
        <box size="0.6 0.6 0.9" />
      </geometry>
      <material name="counter_mat">
        <color rgba="0.8 0.7 0.5 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.6 0.9" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="counter_joint" type="fixed">
    <parent link="world" />
    <child link="counter" />
    <origin xyz="0 0.85 0.45" />
  </joint>
  <link name="eva_mug">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.08" length="0.12" />
      </geometry>
      <material name="mug_mat">
        <color rgba="0.9 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.08" length="0.12" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" />
      <mass value="0.3" />
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>
  </link>
  <joint name="eva_mug_joint" type="fixed">
    <parent link="counter" />
    <child link="eva_mug" />
    <origin xyz="0 -0.22 0.45" />
  </joint>
</robot>