<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mobile cylindrical base with planar virtual joints (x, y, yaw) so it can
       drive from the fridge to the counter. -->
  <xacro:property name="base_radius" value="0.25"/>
  <xacro:property name="base_height" value="0.30"/>
  <xacro:property name="base_mass"   value="20.0"/>

  <xacro:macro name="base" params="parent">
    <link name="base_x_link"/>
    <link name="base_y_link"/>
    <joint name="base_x" type="prismatic">
      <parent link="${parent}"/><child link="base_x_link"/>
      <axis xyz="1 0 0"/><limit lower="-3" upper="3" effort="500" velocity="1.0"/>
    </joint>
    <joint name="base_y" type="prismatic">
      <parent link="base_x_link"/><child link="base_y_link"/>
      <axis xyz="0 1 0"/><limit lower="-3" upper="3" effort="500" velocity="1.0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${base_height/2}"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
        <material name="base_grey"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}"/>
        <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${base_height/2}"/>
        <mass value="${base_mass}"/>
        <inertia ixx="${base_mass*(3*base_radius*base_radius+base_height*base_height)/12}" ixy="0" ixz="0"
                 iyy="${base_mass*(3*base_radius*base_radius+base_height*base_height)/12}" iyz="0"
                 izz="${base_mass*base_radius*base_radius/2}"/>
      </inertial>
    </link>
    <joint name="base_yaw" type="continuous">
      <parent link="base_y_link"/><child link="base_link"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
</robot>
